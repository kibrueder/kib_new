<div class="pt-16">
  {% set cardDelays = ['', 'animate-delay-100', 'animate-delay-200'] %}
  {% set statDelays = ['', 'animate-delay-100', 'animate-delay-200'] %}
  {% set cardSurface = 'bg-white dark:bg-gradient-to-b dark:from-gray-900 dark:to-black border border-gray-200 dark:border-gray-800' %}
  {% set cardMotion = 'transition-all duration-300 ease-out hover:border-yellow-500/50 dark:hover:border-yellow-500/50 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(234,179,8,0.18)] dark:hover:shadow-[0_8px_30px_rgba(234,179,8,0.22)]' %}
  {% set outcomeSurface = 'bg-gray-900 dark:bg-gradient-to-b dark:from-gray-900 dark:to-black border border-gray-800 dark:border-gray-700' %}
  {% set outcomeMotion = 'transition-all duration-300 ease-out hover:border-yellow-500/50 dark:hover:border-yellow-500/50 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(234,179,8,0.22)] dark:hover:shadow-[0_8px_30px_rgba(234,179,8,0.3)]' %}
  {# Hero #}
  <section class="relative overflow-hidden bg-white dark:bg-neutral-950 py-20 md:py-28 border-b border-gray-200 dark:border-gray-800">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute w-[420px] h-[420px] blur-[100px] rounded-full bg-gradient-to-r from-yellow-500/15 to-orange-500/15 -top-32 -right-32 opacity-70 dark:opacity-100"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 md:px-8">
      <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-4 hero-fade" data-i18n="ziva.eyebrow">Local-SEO Case Study</p>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-6 leading-tight">
        <span class="block text-gray-900 dark:text-white hero-fade hero-fade-delay-1" data-i18n="ziva.hero.title">Unsichtbar bei Google.</span>
        <span class="block bg-gradient-to-r from-yellow-500 to-orange-500 text-transparent bg-clip-text hero-fade hero-fade-delay-2" data-i18n="ziva.hero.highlight">Dann Top 3.</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed hero-fade hero-fade-delay-3" data-i18n="ziva.hero.sub">
        zivaclean Gebäudereinigung hatte praktisch keine Online-Präsenz, wer „Gebäudereinigung Langenfeld“ suchte, fand sie nicht. In 5 Monaten haben wir das geändert.
      </p>
    </div>
  </section>

  {# Stats #}
  <section class="bg-gray-50 dark:bg-gray-900/50 border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-6xl mx-auto px-4 md:px-8 py-10">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
        <div class="{{ cardSurface }} rounded-xl p-5 md:p-6 text-center {{ statDelays[0] }} {{ cardMotion }}" data-animate>
          <div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">#45 → <span class="text-yellow-600 dark:text-yellow-400">#2</span></div>
          <div class="text-sm text-gray-500 dark:text-gray-400 mt-2" data-i18n="ziva.stat.rank">Platz bei Google</div>
        </div>
        <div class="{{ cardSurface }} rounded-xl p-5 md:p-6 text-center {{ statDelays[1] }} {{ cardMotion }}" data-animate>
          <div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">0% → <span class="text-yellow-600 dark:text-yellow-400">80%</span></div>
          <div class="text-sm text-gray-500 dark:text-gray-400 mt-2" data-i18n="ziva.stat.visibility">Top 3 in 80% der Suchergebnisse</div>
        </div>
        <div class="{{ cardSurface }} rounded-xl p-5 md:p-6 text-center {{ statDelays[2] }} {{ cardMotion }}" data-animate>
          <div class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">5 <span class="text-base font-semibold text-gray-500 dark:text-gray-400">Mon.</span></div>
          <div class="text-sm text-gray-500 dark:text-gray-400 mt-2" data-i18n="ziva.stat.period">Februar – Juli 2026</div>
        </div>
      </div>
    </div>
  </section>

  {# Problem #}
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div data-animate>
        <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-2" data-i18n="ziva.problem.kicker">Das Problem</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-10" data-i18n="ziva.problem.title">Null Präsenz, unsichtbar dort, wo Kunden suchen</h2>
      </div>
      <div class="grid lg:grid-cols-5 gap-10">
        <aside class="lg:col-span-2 {{ cardSurface }} rounded-2xl p-6 md:p-8 {{ cardMotion }}" data-animate>
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-5" data-i18n="ziva.fact.title">Auf einen Blick</h3>
          <dl class="space-y-4 text-sm">
            <div><dt class="text-yellow-600 dark:text-yellow-500 font-semibold uppercase tracking-wide text-xs mb-1" data-i18n="ziva.fact.client">Kunde</dt><dd class="text-gray-700 dark:text-gray-300" data-i18n="ziva.fact.clientVal">zivaclean Gebäudereinigung</dd></div>
            <div><dt class="text-yellow-600 dark:text-yellow-500 font-semibold uppercase tracking-wide text-xs mb-1" data-i18n="ziva.fact.industry">Branche</dt><dd class="text-gray-700 dark:text-gray-300" data-i18n="ziva.fact.industryVal">Gebäude- &amp; Unterhaltsreinigung</dd></div>
            <div><dt class="text-yellow-600 dark:text-yellow-500 font-semibold uppercase tracking-wide text-xs mb-1" data-i18n="ziva.fact.market">Markt</dt><dd class="text-gray-700 dark:text-gray-300" data-i18n="ziva.fact.marketVal">Langenfeld (Rheinland) &amp; Umgebung</dd></div>
            <div><dt class="text-yellow-600 dark:text-yellow-500 font-semibold uppercase tracking-wide text-xs mb-1" data-i18n="ziva.fact.keyword">Haupt-Keyword</dt><dd class="text-gray-700 dark:text-gray-300" data-i18n="ziva.fact.keywordVal">Gebäudereinigung Langenfeld</dd></div>
            <div><dt class="text-yellow-600 dark:text-yellow-500 font-semibold uppercase tracking-wide text-xs mb-1" data-i18n="ziva.fact.period">Zeitraum</dt><dd class="text-gray-700 dark:text-gray-300" data-i18n="ziva.fact.periodVal">Februar 2026 – Juli 2026</dd></div>
          </dl>
        </aside>
        <div class="lg:col-span-3" data-animate>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-6" data-i18n="ziva.problem.lede">zivaclean hatte einen soliden Reinigungsbetrieb, bei Google aber praktisch keine Chance.</p>
          <p class="font-semibold text-gray-900 dark:text-white mb-3" data-i18n="ziva.problem.standing">So stand es:</p>
          <ul class="space-y-3 text-gray-600 dark:text-gray-400">
            <li class="flex gap-3"><span class="text-red-500 shrink-0">✕</span><span data-i18n="ziva.problem.li1">0 % Top-3-Sichtbarkeit</span></li>
            <li class="flex gap-3"><span class="text-red-500 shrink-0">✕</span><span data-i18n="ziva.problem.li3">Rang #45 unter lokalen Wettbewerbern</span></li>
            <li class="flex gap-3"><span class="text-red-500 shrink-0">✕</span><span data-i18n="ziva.problem.li4">Praktisch unsichtbar online</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {# Before heatmap #}
  <section class="py-16 md:py-20 bg-gray-50 dark:bg-gray-900/40 border-y border-gray-200 dark:border-gray-800">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div data-animate>
        <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-2" data-i18n="ziva.baseline.kicker">Beweis, vorher</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4" data-i18n="ziva.baseline.title">Rot auf der ganzen Karte, niemand findet sie</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-3xl" data-i18n="ziva.baseline.lede">Februar 2026: An fast jedem Messpunkt Position 20 oder schlechter.</p>
      </div>
      <figure class="{{ cardSurface }} rounded-2xl overflow-hidden shadow-sm dark:shadow-none" data-animate>
        <img src="/case-studies/zivaclean/ranking-before.webp" alt="Heatmap Februar 2026, rot" class="w-full h-auto" width="1600" height="1034" loading="lazy" decoding="async" />
        <figcaption class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-gray-800" data-i18n="ziva.baseline.caption">Ausgangslage, 11. Feb. 2026.</figcaption>
      </figure>
    </div>
  </section>

  {# Roadblocks #}
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div data-animate>
        <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-2" data-i18n="ziva.roadblocks.kicker">Hindernisse</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-10" data-i18n="ziva.roadblocks.title">Warum sie unsichtbar blieben</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {% for n in [1, 2, 3] %}
        <div class="{{ cardSurface }} rounded-2xl p-6 relative {{ cardDelays[loop.index0] }} {{ cardMotion }}" data-animate>
          <span class="absolute top-4 right-4 text-xs font-bold text-gray-300 dark:text-gray-600">0{{ n }}</span>
          <div class="w-10 h-10 rounded-xl bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 flex items-center justify-center mb-4 text-lg">✕</div>
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-3" data-i18n="ziva.roadblocks.p{{ n }}.title"></h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed" data-i18n="ziva.roadblocks.p{{ n }}.text"></p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# Solution #}
  <section class="py-16 md:py-20 bg-gray-50 dark:bg-gray-900/40 border-y border-gray-200 dark:border-gray-800">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div data-animate>
        <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-2" data-i18n="ziva.solution.kicker">Was wir gemacht haben</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4" data-i18n="ziva.solution.title">Drei Säulen, von unsichtbar zu findbar</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-10 max-w-3xl leading-relaxed" data-i18n="ziva.solution.lede">Citations, Google-Unternehmensprofil und OnPage-SEO.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {% for n in [1, 2, 3] %}
        <div class="{{ cardSurface }} rounded-2xl p-6 relative {{ cardDelays[loop.index0] }} {{ cardMotion }}" data-animate>
          <span class="absolute top-4 right-4 text-xs font-bold text-gray-300 dark:text-gray-600">0{{ n }}</span>
          <div class="w-10 h-10 rounded-xl bg-yellow-100 dark:bg-yellow-900/30 text-yellow-600 dark:text-yellow-400 flex items-center justify-center mb-4 text-lg">{% if n == 1 %}↗{% elif n == 2 %}★{% else %}✎{% endif %}</div>
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-3" data-i18n="ziva.solution.p{{ n }}.title"></h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed" data-i18n="ziva.solution.p{{ n }}.text"></p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  {# Outcome #}
  <section class="py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div data-animate>
        <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-2" data-i18n="ziva.outcome.kicker">Das Ergebnis</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4" data-i18n="ziva.outcome.title">Jetzt finden Kunden sie bei Google</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-10 max-w-3xl leading-relaxed" data-i18n="ziva.outcome.lede">Top 3 für „Gebäudereinigung Langenfeld“.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="{{ outcomeSurface }} rounded-2xl p-8 text-center {{ cardDelays[0] }} {{ outcomeMotion }}" data-animate>
          <div class="text-4xl font-bold text-yellow-500 dark:text-yellow-400 mb-2">#2</div>
          <div class="text-sm text-gray-300 dark:text-gray-400" data-i18n="ziva.outcome.s1">Platz 2 bei Google</div>
        </div>
        <div class="{{ outcomeSurface }} rounded-2xl p-8 text-center {{ cardDelays[1] }} {{ outcomeMotion }}" data-animate>
          <div class="text-4xl font-bold text-yellow-500 dark:text-yellow-400 mb-2">80%</div>
          <div class="text-sm text-gray-300 dark:text-gray-400" data-i18n="ziva.outcome.s2">Top 3 in 80% der Suchergebnisse</div>
        </div>
        <div class="{{ outcomeSurface }} rounded-2xl p-8 text-center {{ cardDelays[2] }} {{ outcomeMotion }}" data-animate>
          <div class="text-3xl md:text-4xl font-bold text-yellow-500 dark:text-yellow-400 mb-2" data-i18n="ziva.outcome.s3num">Mehr</div>
          <div class="text-sm text-gray-300 dark:text-gray-400" data-i18n="ziva.outcome.s3">Anfragen, ohne Werbekosten</div>
        </div>
      </div>
    </div>
  </section>

  {# After heatmap + table #}
  <section class="py-16 md:py-20 bg-gray-50 dark:bg-gray-900/40 border-t border-gray-200 dark:border-gray-800">
    <div class="max-w-6xl mx-auto px-4 md:px-8">
      <div data-animate>
        <p class="text-yellow-600 dark:text-yellow-500 font-semibold text-sm uppercase tracking-widest mb-2" data-i18n="ziva.proof.kicker">Beweis, nachher</p>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4" data-i18n="ziva.proof.title">Grün auf der ganzen Karte, Top 3</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-3xl" data-i18n="ziva.proof.lede">Juli 2026: Durchschnittsposition 2,1.</p>
      </div>
      <figure class="{{ cardSurface }} rounded-2xl overflow-hidden shadow-sm dark:shadow-none mb-12" data-animate>
        <img src="/case-studies/zivaclean/ranking-after.webp" alt="Heatmap Juli 2026, grün Top 3" class="w-full h-auto" width="1600" height="996" loading="lazy" decoding="async" />
        <figcaption class="px-5 py-4 text-sm text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-gray-800" data-i18n="ziva.proof.caption">Nach 5 Monaten, 4. Jul. 2026.</figcaption>
      </figure>

      <div class="overflow-x-auto rounded-2xl {{ cardSurface }} {{ cardMotion }}" data-animate>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800 text-left">
              <th class="px-5 py-4 font-semibold text-gray-900 dark:text-white" data-i18n="ziva.table.metric">Kennzahl</th>
              <th class="px-5 py-4 font-semibold text-gray-500" data-i18n="ziva.table.feb">Feb 2026</th>
              <th class="px-5 py-4 font-semibold text-yellow-600 dark:text-yellow-400" data-i18n="ziva.table.jul">Jul 2026</th>
            </tr>
          </thead>
          <tbody class="text-gray-700 dark:text-gray-300">
            <tr class="border-b border-gray-100 dark:border-gray-800"><td class="px-5 py-4" data-i18n="ziva.table.r2">Platz bei Google</td><td class="px-5 py-4 text-red-600 dark:text-red-400 font-semibold">#45</td><td class="px-5 py-4 text-yellow-600 dark:text-yellow-400 font-semibold">#2</td></tr>
            <tr><td class="px-5 py-4" data-i18n="ziva.table.r3">Top 3 in lokalen Suchergebnissen</td><td class="px-5 py-4 text-red-600 dark:text-red-400 font-semibold">0%</td><td class="px-5 py-4 text-yellow-600 dark:text-yellow-400 font-semibold">80%</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-500 mt-6 text-center" data-i18n="ziva.footer">Ranking-Daten aus lokalem Heatmap-Tracking.</p>
    </div>
  </section>

  {# CTA #}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-8">
      {% set ctaTitle = "Auch bei Google unsichtbar?" %}
      {% set ctaText = "Wenn Kunden nach dem suchen, was Sie anbieten, und Sie nie finden, schauen wir gemeinsam, wo Sie stehen." %}
      {% set ctaButton = "Kostenloses Gespräch" %}
      <div class="bg-gradient-to-r from-yellow-500 to-orange-500 rounded-2xl p-10 md:p-12 text-center text-white" data-animate>
        <h2 class="text-3xl font-bold mb-4" data-i18n="ziva.cta.title">{{ ctaTitle }}</h2>
        <p class="text-white/90 mb-8 text-lg max-w-xl mx-auto" data-i18n="ziva.cta.text">{{ ctaText }}</p>
        <a href="/kontakt/" class="inline-block bg-white text-yellow-600 hover:bg-yellow-50 font-bold px-8 py-4 rounded-lg transition-all text-lg" data-i18n="ziva.cta.btn">{{ ctaButton }}</a>
      </div>
    </div>
  </section>
</div>
