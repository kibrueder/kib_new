<!DOCTYPE html>
<html lang="de" class="no-js">
<head>
  {% include "head.njk" %}
  <script>document.documentElement.classList.remove('no-js');</script>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-black text-gray-900 dark:text-white{% if storyJs %} story-v2-body{% else %} inner-page{% endif %}">
  {% include "navbar.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}
  {% include "mobile-cta.njk" %}
  {% include "cookie-banner.njk" %}

  <script src="/js/config.js"></script>
  <script src="/js/main.js" defer></script>
  {% if bilingual %}
  <script>
    (function () {
      var I18N = '/js/i18n.js?v=20260880';
      var queue = [];
      function run(lang) {
        if (typeof window.applyLanguage === 'function') {
          window.applyLanguage(lang);
          return;
        }
        queue.push(lang);
        if (document.querySelector('script[data-i18n-src]')) return;
        var s = document.createElement('script');
        s.src = I18N;
        s.defer = true;
        s.setAttribute('data-i18n-src', '1');
        s.onload = function () {
          var next = queue.pop() || lang;
          queue = [];
          if (typeof window.applyLanguage === 'function') window.applyLanguage(next);
        };
        document.head.appendChild(s);
      }
      document.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.lang-btn') : null;
        if (btn) run(btn.getAttribute('data-lang'));
      });
      try {
        if (localStorage.getItem('language') === 'en') run('en');
      } catch (err) {}
    })();
  </script>
  {% endif %}
  {% if storyJs %}
  <script src="/js/story-v2.js?v=20260880" defer></script>
  {% endif %}
  {% if hasForms %}
  <script type="module" src="/js/forms.js"></script>
  {% endif %}
</body>
</html>
